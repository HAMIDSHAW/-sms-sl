FLASK_ENV=development
# Generate each secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# They must be different, at least 32 characters, and never committed. The backend refuses to
# start in production with the built-in default.
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# --- Database ---
# Leave DATABASE_URL unset to fall back to local SQLite (dev.db) for quick
# local testing -- this is what running the app with no setup at all uses.
#
# For Supabase Postgres in production, use the "Connection pooling" URI
# from Supabase -> Project Settings -> Database (NOT the direct connection --
# the pooled one handles Render's connection pattern much better), with
# +psycopg2 added after postgresql so SQLAlchemy picks the right driver:
# DATABASE_URL=postgresql+psycopg2://postgres.xxxxx:PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres

# --- CORS ---
# The exact URL of your frontend (comma-separate if you add a custom domain).
# Never use * : the backend refuses to start in production with a wildcard.
# Local dev works with no value at all (it allows http://localhost:5173).
CORS_ORIGINS=http://localhost:5173

# --- File uploads (profile photos, school logo, assignment attachments) ---
# Leave all of these unset to save files to local disk -- fine for local
# dev, WRONG for Render (its filesystem doesn't persist between deploys).
# Set all five once you've created a bucket in Supabase Storage:
#   UPLOAD_S3_ENDPOINT          https://<project-ref>.supabase.co/storage/v1/s3
#   UPLOAD_S3_BUCKET             the bucket name you created
#   UPLOAD_S3_ACCESS_KEY         Storage -> S3 Access Keys -> create new
#   UPLOAD_S3_SECRET_KEY         (shown once when you create the access key)
#   UPLOAD_PUBLIC_BASE_URL       https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
#                                 (only works if the bucket is set Public)
UPLOAD_S3_ENDPOINT=
UPLOAD_S3_BUCKET=
UPLOAD_S3_ACCESS_KEY=
UPLOAD_S3_SECRET_KEY=
# The region shown on Supabase's Storage S3 connection page, for example eu-central-1. Uploads are
# signed with it, so a wrong value is rejected.
UPLOAD_S3_REGION=
UPLOAD_PUBLIC_BASE_URL=

# --- Background scheduler (period-starting-soon reminders) ---
# Leave as 1 on exactly ONE running process. If you deploy the backend as
# more than one Render instance/worker, set this to 0 on all but one, or
# every instance will send the same reminder separately. See
# app/__init__.py and app/utils/period_reminders.py for details.
SCHEDULER_ENABLED=1

# --- Demo school on a deployed site (optional) ---
# SEED_DEMO_ON_BOOT=1 loads the demo school the first time the app starts on an EMPTY database, then does
# nothing on later starts. Every demo account shares DEMO_PASSWORD, so choose a private one: the app refuses
# to seed a real deployment with the public password in the README. Remove SEED_DEMO_ON_BOOT afterwards.
SEED_DEMO_ON_BOOT=
DEMO_PASSWORD=
